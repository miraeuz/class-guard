<Application x:Class="ClassroomGuard.Admin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentText" Color="#6D3CE8"/>
        <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EEE5FF" Offset="0"/><GradientStop Color="#E0F5F5" Offset="1"/></LinearGradientBrush>
        <Style TargetType="ScrollViewer"><Setter Property="PanningMode" Value="VerticalFirst"/></Style>
        <!-- Clean education palette: white surface, soft gray, teal accent -->
        <SolidColorBrush x:Key="BgApp" Color="#F5F3FC"/>
        <SolidColorBrush x:Key="BgSidebar" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgCard" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgInput" Color="#FAF9FE"/>
        <SolidColorBrush x:Key="BgHover" Color="#EEF2FF"/>
        <SolidColorBrush x:Key="BgNavActive" Color="#EEE7FF"/>
        <SolidColorBrush x:Key="Border" Color="#E5DFF2"/>
        <SolidColorBrush x:Key="BorderFocus" Color="#7C3AED"/>
        <SolidColorBrush x:Key="Text" Color="#211A38"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#514763"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B607C"/>
        <SolidColorBrush x:Key="Accent" Color="#6D3CE8"/>
        <SolidColorBrush x:Key="AccentHover" Color="#5427BD"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#EEE7FF"/>
        <SolidColorBrush x:Key="Success" Color="#059669"/>
        <SolidColorBrush x:Key="SuccessSoft" Color="#D1FAE5"/>
        <SolidColorBrush x:Key="Warning" Color="#D97706"/>
        <SolidColorBrush x:Key="WarningSoft" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="Danger" Color="#DC2626"/>
        <SolidColorBrush x:Key="DangerSoft" Color="#FEE2E2"/>

        <SolidColorBrush x:Key="HeaderBg" Color="#26194A"/>
        <SolidColorBrush x:Key="HeaderText" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="HeaderTextMuted" Color="#D6C8EE"/>
        <SolidColorBrush x:Key="TassleAccent" Color="#38BDF8"/>

        <!-- Brand mark: graduation cap, vector — matches app.ico exactly so the taskbar
             icon and every in-app badge are the same glyph, not a mismatched emoji.
             Usage: <ContentControl Template="{StaticResource SchoolMarkTemplate}"
                                     Foreground="White" Tag="{DynamicResource TassleAccent}"
                                     Width="28" Height="28"/> -->
        <ControlTemplate x:Key="SchoolMarkTemplate" TargetType="ContentControl">
            <Viewbox Stretch="Uniform">
                <Canvas Width="24" Height="24">
                    <Polygon Points="12,4 21,9 12,14 3,9" Fill="{TemplateBinding Foreground}"/>
                    <Rectangle Canvas.Left="8" Canvas.Top="10.6" Width="8" Height="3.6"
                               RadiusX="1.5" RadiusY="1.5" Fill="{TemplateBinding Foreground}"/>
                    <Ellipse Canvas.Left="11.2" Canvas.Top="2.9" Width="1.6" Height="1.6"
                             Fill="{TemplateBinding Tag}"/>
                    <Line X1="12.6" Y1="3.8" X2="15" Y2="8.5"
                          Stroke="{TemplateBinding Tag}" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Ellipse Canvas.Left="14.1" Canvas.Top="8.3" Width="2" Height="2" Fill="{TemplateBinding Tag}"/>
                </Canvas>
            </Viewbox>
        </ControlTemplate>

        <!-- 2x2 monitor-grid glyph — "Boshqaruv" (Dashboard / lab overview). -->
        <ControlTemplate x:Key="IconDashboard" TargetType="ContentControl">
            <Viewbox Stretch="Uniform">
                <Canvas Width="24" Height="24">
                    <Rectangle Canvas.Left="3" Canvas.Top="3" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{TemplateBinding Foreground}"/>
                    <Rectangle Canvas.Left="13" Canvas.Top="3" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{TemplateBinding Foreground}" Opacity="0.55"/>
                    <Rectangle Canvas.Left="3" Canvas.Top="13" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{TemplateBinding Foreground}" Opacity="0.55"/>
                    <Rectangle Canvas.Left="13" Canvas.Top="13" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{TemplateBinding Foreground}"/>
                </Canvas>
            </Viewbox>
        </ControlTemplate>

        <!-- Paper-plane / send arrow glyph — "Push". -->
        <ControlTemplate x:Key="IconPush" TargetType="ContentControl">
            <Viewbox Stretch="Uniform">
                <Canvas Width="24" Height="24">
                    <Polygon Points="3,12 20,4 13,21 10.5,13.5 3,12" Fill="{TemplateBinding Foreground}"/>
                    <Polygon Points="10.5,13.5 20,4 12.7,15.3" Fill="{TemplateBinding Foreground}" Opacity="0.55"/>
                </Canvas>
            </Viewbox>
        </ControlTemplate>

        <!-- Three sliders glyph — "Sozlamalar" (Settings). -->
        <ControlTemplate x:Key="IconSettings" TargetType="ContentControl">
            <Viewbox Stretch="Uniform">
                <Canvas Width="24" Height="24">
                    <Line X1="3" Y1="6" X2="21" Y2="6" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round"/>
                    <Line X1="3" Y1="12" X2="21" Y2="12" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round"/>
                    <Line X1="3" Y1="18" X2="21" Y2="18" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round"/>
                    <Ellipse Canvas.Left="13" Canvas.Top="4" Width="4" Height="4" Fill="{TemplateBinding Foreground}"/>
                    <Ellipse Canvas.Left="6" Canvas.Top="10" Width="4" Height="4" Fill="{TemplateBinding Foreground}"/>
                    <Ellipse Canvas.Left="15" Canvas.Top="16" Width="4" Height="4" Fill="{TemplateBinding Foreground}"/>
                </Canvas>
            </Viewbox>
        </ControlTemplate>

        <Style TargetType="Window"><Setter Property="UseLayoutRounding" Value="True"/><Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource BgApp}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13.5"/>
        </Style>

        <!-- Help ? badge -->
        <Style x:Key="HelpIcon" TargetType="Border">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
            <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
        </Style>
        <Style x:Key="HelpIconText" TargetType="TextBlock">
            <Setter Property="Text" Value="?"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Bd" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavBtnActive" TargetType="Button" BasedOn="{StaticResource NavBtn}">
            <Setter Property="Background" Value="{DynamicResource BgNavActive}"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Bd" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Bd" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="{DynamicResource Danger}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="FontSize" Value="13.5"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
        </Style>

        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.06" Color="#0F172A"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MachineCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="StatusPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Rich tooltip -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="MaxWidth" Value="320"/>
            <Setter Property="HasDropShadow" Value="True"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource BgInput}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8"><TextBlock Text="⌄" HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></Border></ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,8,24,8" IsHitTestVisible="False"/>
                    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="280"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border>
                    </Popup>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource BgCard}"/><Setter Property="Padding" Value="10,8"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger></Style.Triggers></Style>
    </Application.Resources>
</Application>
