<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassroomGuard.Admin.MainWindow" Title="ClassroomGuard Master — O‘qituvchi" Height="740" Width="1120" MinHeight="460" MinWidth="800" WindowStartupLocation="CenterScreen" Icon="app.ico" Background="{DynamicResource BgApp}" UseLayoutRounding="True" SizeChanged="OnAdminResize">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" x:Name="AdminSidebarColumn"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        
        <Border Grid.Column="0" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Button DockPanel.Dock="Top" Content="" FontFamily="Segoe MDL2 Assets" Style="{StaticResource BtnSecondary}" MinWidth="40" HorizontalAlignment="Left" Margin="12" Click="OnToggleAdminSidebar" ToolTip="Menyuni yig‘ish / yoyish" AutomationProperties.Name="Menyuni yig‘ish yoki yoyish"/><StackPanel DockPanel.Dock="Top" Margin="22,28,22,20" x:Name="AdminSidebarBrand">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource HeaderBg}" Margin="0,0,12,0">
                            <ContentControl Template="{StaticResource SchoolMarkTemplate}" Width="19" Height="19" Foreground="White" Tag="{DynamicResource TassleAccent}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ClassroomGuard" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="Master" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock x:Name="KeyStatus" Text="Kalit yuklanmagan" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,20" x:Name="AdminSidebarFooter">
                    <TextBlock x:Name="DashStatus" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel>
                    <Button x:Name="NavDash" Style="{StaticResource NavBtnActive}" Click="OnNav">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Template="{StaticResource IconDashboard}" Width="16" Height="16" Margin="0,0,10,0"/>
                            <TextBlock Text="Boshqaruv" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavPush" Style="{StaticResource NavBtn}" Click="OnNav">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Template="{StaticResource IconPush}" Width="16" Height="16" Margin="0,0,10,0"/>
                            <TextBlock Text="Push (yuborish)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSettings" Style="{StaticResource NavBtn}" Click="OnNav">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Template="{StaticResource IconSettings}" Width="16" Height="16" Margin="0,0,10,0"/>
                            <TextBlock Text="Sozlamalar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        
        <Grid Grid.Column="1" Margin="28,24">

            
            <DockPanel x:Name="PageDash"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="{Binding Text, ElementName=DashStatus}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Sinf boshqaruvi" Style="{StaticResource H1}"/><TextBlock Text="MIRAE ACADEMY · O‘QITUVCHI ISH MAYDONI" Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
                        <Button Grid.Column="1" x:Name="ThemeButton" Content="☾ Tun" Click="OnToggleTheme" Style="{StaticResource BtnSecondary}" ToolTip="Kunduzgi / tungi ko‘rinish"/>
                    </Grid>
                    <Border Background="{DynamicResource HeroGradient}" CornerRadius="18" Padding="16" Margin="0,16,0,12">
                        <StackPanel><TextBlock x:Name="MachineCount" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="OverviewText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                    </Border>
                    <WrapPanel>
                        <Button Content="↻ Yangilash" Style="{StaticResource BtnSecondary}" Click="OnRefresh"/>
                        <Button Content="Barcha ekranlarni qulflash" Style="{StaticResource BtnPrimary}" Click="OnScreenLockAll"/>
                        <Button Content="Barcha ekranlarni ochish" Style="{StaticResource BtnSecondary}" Click="OnScreenUnlockAll"/>
                        <Button Content="Faoliyat tarixi" Click="OnActivityHistory" Style="{StaticResource BtnSecondary}"/><Button Content="Sinxronlash" Style="{StaticResource BtnSecondary}" Click="OnReconcile"/>
                        <Expander Header="Ilova cheklovlari" Margin="8"><WrapPanel><Button Content="Barchasini cheklash" Click="OnLockAll" Style="{StaticResource BtnSecondary}"/><Button Content="30 daqiqa ruxsat" Click="OnUnlockAll" Style="{StaticResource BtnSecondary}"/></WrapPanel></Expander>
                    </WrapPanel>
                    <WrapPanel Margin="0,10,0,0">
                        <ComboBox x:Name="GroupSelector" Width="180" Margin="0,0,10,0" SelectionChanged="OnGroupChanged" ToolTip="Guruhni tanlang"/><TextBox x:Name="MachineSearch" Width="200" TextChanged="OnMachineSearch" ToolTip="PC nomi, IP yoki ID bo‘yicha qidirish" AutomationProperties.Name="Kompyuterlarni qidirish" Margin="0,0,10,0"/>
                        <CheckBox x:Name="SeatingToggle" Content="O‘tirish rejasi" VerticalAlignment="Center" Click="OnViewChanged" Margin="0,0,12,0"/>
                        <TextBlock Text="Ustunlar:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="SeatColumns" Width="65" SelectedIndex="2" SelectionChanged="OnColumnsChanged"><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/></ComboBox>
                    </WrapPanel>
                    <Border CornerRadius="12" Background="{DynamicResource AccentSoft}" Padding="10" Margin="0,10,0,0">
                        <WrapPanel><TextBlock x:Name="SelectionText" Text="0 ta tanlangan" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="Ko‘rinayotganlarni tanlash" Click="OnSelectVisible" Style="{StaticResource BtnSecondary}"/><Button Content="Tozalash" Click="OnClearSelection" Style="{StaticResource BtnSecondary}"/>
                        <Button x:Name="SelectedLockButton" Content="Tanlanganlarni qulflash" Click="OnLockSelected" Style="{StaticResource BtnPrimary}"/>
                        <Button x:Name="SelectedUnlockButton" Content="Tanlanganlarni ochish" Click="OnUnlockSelected" Style="{StaticResource BtnSecondary}"/><Button Content="Testni pauza qilish" Click="OnPauseSelected" Style="{StaticResource BtnSecondary}"/><Button Content="Testni davom ettirish" Click="OnResumeSelected" Style="{StaticResource BtnSecondary}"/><Expander Header="Tanlangan PC ilovalari" Margin="8"><WrapPanel><Button Content="Cheklash" Click="OnRestrictSelected" Style="{StaticResource BtnSecondary}"/><Button Content="30 daqiqa ruxsat" Click="OnPermitSelected" Style="{StaticResource BtnSecondary}"/></WrapPanel></Expander></WrapPanel>
                    </Border>
                    <Expander Header="Dars sessiyasi · tanlangan PC yoki joriy guruh" Margin="0,12,0,0">
                        <StackPanel><WrapPanel><TextBox x:Name="LessonTitleBox" Width="220" MaxLength="120" ToolTip="Dars nomi" Margin="0,8,10,8"/><TextBox x:Name="LessonGroupBox" Width="140" MaxLength="80" ToolTip="Dars guruhi" Margin="0,8,10,8"/><Button Content="Darsni boshlash" Click="OnBeginLesson" Style="{StaticResource BtnPrimary}"/><Button Content="Darsni yakunlash" Click="OnEndLesson" Style="{StaticResource BtnSecondary}"/></WrapPanel>
                        <TextBlock Text="Push sahifasidagi ilovalar, saytlar va testlar dars siyosati sifatida olinadi. Ekran qulfi va test pauzasi alohida." TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/></StackPanel>
                    </Expander>
                </StackPanel>
                <Grid x:Name="WorkspaceGrid">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailsColumn" Width="280"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel x:Name="MachineHost" Margin="0,0,16,0">
                            <Border x:Name="TeacherDesk" Visibility="Collapsed" Background="{DynamicResource BgCard}" CornerRadius="10" Padding="10" Margin="0,0,0,12"><TextBlock Text="DOSKA · O‘QITUVCHI" HorizontalAlignment="Center" FontWeight="SemiBold"/></Border>
                            <TextBlock x:Name="MachineEmpty" Text="Kompyuter topilmadi. Agent va tarmoq ulanishini tekshiring." TextWrapping="Wrap" Margin="0,20" Foreground="{DynamicResource TextMuted}"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><WrapPanel x:Name="MachinePanel" SizeChanged="OnMachineAreaResize"/></ScrollViewer>
                        </StackPanel>
                        <Border x:Name="DetailsPanel" Grid.Column="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="18" Padding="18" VerticalAlignment="Top">
                            <StackPanel><TextBlock Text="PC tafsilotlari" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DetailTitle" Text="Kompyuterni tanlang" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,6" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DetailText" Text="Holat, ulanish sababi va keyingi qadam shu yerda ko‘rinadi." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                            <Separator Margin="0,16"/>
                            <TextBlock Text="O‘quvchi nomi (qo‘lda biriktiriladi)"/><TextBox x:Name="StudentNameBox" MaxLength="80" Margin="0,6,0,10"/>
                            <TextBlock Text="Guruh"/><TextBox x:Name="StudentGroupBox" MaxLength="80" Margin="0,6,0,10"/><Button Content="Nom va guruhni saqlash" Click="OnSaveProfile" Style="{StaticResource BtnSecondary}"/>
                            <TextBlock Text="O‘rindiq raqami (1–120)"/>
                            <TextBox x:Name="SeatNumberBox" MaxLength="3" Margin="0,6,0,10" AutomationProperties.Name="O‘rindiq raqami"/>
                            <WrapPanel><Button Content="Saqlash" Click="OnSaveSeat" Style="{StaticResource BtnPrimary}"/><Button Content="Olib tashlash" Click="OnRemoveSeat" Style="{StaticResource BtnSecondary}"/></WrapPanel>
                            <TextBlock x:Name="SeatStatus" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                            <TextBlock Text="O‘rindiq joylashuvi faqat ushbu o‘qituvchi hisobida saqlanadi." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

            </StackPanel></ScrollViewer>
            </DockPanel>

            <ScrollViewer x:Name="PagePush" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentSoft}" Margin="0,0,12,0">
                            <ContentControl Template="{StaticResource IconPush}" Width="16" Height="16" Foreground="{DynamicResource Accent}"/>
                        </Border>
                        <TextBlock Text="Push — o‘zgarishlarni yuborish" Style="{StaticResource H1}"/>
                        <Border Style="{StaticResource HelpIcon}" ToolTip="Saytlar va qoidalarni o‘zgartiring, keyin bitta tugma bilan barcha topilgan kompyuterlarga yuboring (Veyon uslubi).">
                            <TextBlock Style="{StaticResource HelpIconText}"/>
                        </Border>
                    </StackPanel>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="1. Saytlar" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton x:Name="SiteOff" Content="O‘chiq" GroupName="SiteMode"/>
                                <RadioButton x:Name="SiteBlack" Content="Qora ro‘yxat" GroupName="SiteMode" IsChecked="True"/>
                                <RadioButton x:Name="SiteWhite" Content="Oq ro‘yxat (HOZIR ISHLAMAYDI — hosts)" GroupName="SiteMode" IsEnabled="False"/>
                            </StackPanel>
                            <TextBlock Text="Domenlar (har qatorda bittadan)" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                            <TextBox x:Name="SitesBox" Height="160" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="2. Qoidalar" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                            <CheckBox x:Name="StudentModeChk" Content="Baseline: Student Mode (temporary unlock is on Dashboard)" IsChecked="True" IsEnabled="False"/>
                            <CheckBox x:Name="InstallChk" Content="Dastur o‘rnatishni bloklash (WMI + kod)" IsChecked="True"/>
                            <CheckBox x:Name="DownloadChk" Content="Brauzerdan yuklab olishni bloklash (Chrome/Edge)" IsChecked="True"/>
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" Text="Downloads: Chrome/Edge only. Install/app filtering is reactive. SRP is unavailable. Students must use standard Windows accounts."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="3. Ruxsat etilgan dasturlar (Allow-list)" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                            <CheckBox x:Name="AppAllowChk" Content="Student process filter — reactive, Windows tools remain available" IsChecked="False" Margin="0,0,0,10"/>
                            <TextBlock Text="EXE in Windows/Program Files, or exact protected path. No wildcard/substrings." Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                            <TextBox x:Name="AppsBox" Height="140" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Text="WINWORD.EXE&#10;EXCEL.EXE&#10;POWERPNT.EXE&#10;chrome.exe&#10;msedge.exe&#10;notepad.exe&#10;calc.exe"/>
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" Text="Masalan: WINWORD.EXE, EXCEL.EXE, CapCut.exe. Bo‘sh qatorlar e’tiborsiz. Tizim dasturlari (explorer va h.k.) avtomatik himoyalangan."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="4. Kutubxona (PDF + online)" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6" Text="Har qator: kind|sarlavha|yo‘l-yoki-url|kategoriya  (kind = offline yoki online)"/>
                            <TextBox x:Name="LibraryBox" Height="120" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Text="online|Khan Academy|https://www.khanacademy.org|Matematika"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="5. Testlar (JSON)" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6" Text="JSON massiv: [{ title, className, subject, timeLimitMinutes, questions:[{ text, options:[], correctIndex }] }]"/>
                            <TextBox x:Name="TestsJsonBox" Height="140" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Text="[&#10;  {&#10;    &quot;title&quot;: &quot;Matematika nazorat&quot;,&#10;    &quot;className&quot;: &quot;7-A&quot;,&#10;    &quot;subject&quot;: &quot;Matematika&quot;,&#10;    &quot;timeLimitMinutes&quot;: 15,&#10;    &quot;questions&quot;: [&#10;      {&#10;        &quot;text&quot;: &quot;2 + 2 = ?&quot;,&#10;        &quot;options&quot;: [&quot;3&quot;, &quot;4&quot;, &quot;5&quot;],&#10;        &quot;correctIndex&quot;: 1&#10;      },&#10;      {&#10;        &quot;text&quot;: &quot;5 × 3 = ?&quot;,&#10;        &quot;options&quot;: [&quot;15&quot;, &quot;8&quot;, &quot;10&quot;],&#10;        &quot;correctIndex&quot;: 0&#10;      }&#10;    ]&#10;  }&#10;]"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="JSON fayldan yuklash…" Style="{StaticResource BtnSecondary}" Click="OnLoadTestsJson"/>
                                <TextBlock x:Name="TestsJsonStatus" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5">
                        <StackPanel>
                            <TextBlock Text="6. Yuborish" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" Text="Saytlar + qoidalar + dasturlar + kutubxona + testlar barcha online agentlarga yuboriladi."/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Barcha kompyuterlarga Push" Style="{StaticResource BtnPrimary}" FontSize="14" Padding="20,12" Click="OnPushAll"/><Button Content="Tanlangan PC ga siyosat / testlar" Click="OnPushSelected" Style="{StaticResource BtnSecondary}"/>
                                <TextBlock x:Name="PushStatus" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{DynamicResource Success}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            
            <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentSoft}" Margin="0,0,12,0">
                            <ContentControl Template="{StaticResource IconSettings}" Width="16" Height="16" Foreground="{DynamicResource Accent}"/>
                        </Border>
                        <TextBlock Text="Sozlamalar" Style="{StaticResource H1}"/>
                        <Border Style="{StaticResource HelpIcon}" ToolTip="Sinf kaliti, offline kod va Telegram.">
                            <TextBlock Style="{StaticResource HelpIconText}"/>
                        </Border>
                    </StackPanel>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Sinf kaliti" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12" Text="Odatda Setup sinf parolidan kalitni avtomatik o‘rnatadi. Qo‘lda: classroom.key ni yuklang yoki yangi yarating."/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Kalit faylini yuklash…" Style="{StaticResource BtnSecondary}" Click="OnLoadKey"/>
                                <Button Content="Yangi kalit yaratish" Style="{StaticResource BtnSecondary}" Click="OnGenerateKey"/>
                                <TextBlock x:Name="KeyPreview" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Offline ochish kodi (TOTP)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="UnlockMachineId" Width="220"/>
                                <Button Content="Kodni ko‘rsatish" Style="{StaticResource BtnPrimary}" Click="OnShowCode"/>
                                <TextBlock x:Name="UnlockCode" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Admin Telegram test only — configure result delivery on each Agent" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="Bot token" Style="{StaticResource Muted}"/>
                            <TextBox x:Name="TgToken"/>
                            <TextBlock Text="Chat ID" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                            <TextBox x:Name="TgChat"/>
                            <TextBlock Text="UDP port" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                            <TextBox x:Name="PortBox" Width="120" HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Saqlash" Style="{StaticResource BtnPrimary}" Click="OnSaveSettings"/>
                                <TextBlock x:Name="SettingsStatus" Foreground="{DynamicResource Success}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
