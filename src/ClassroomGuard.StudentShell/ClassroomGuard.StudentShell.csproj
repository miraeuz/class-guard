<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WPF has no native tray-icon API; NotifyIcon comes from WinForms interop. -->
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ClassroomGuard.StudentShell</RootNamespace>
    <AssemblyName>ClassroomGuard.StudentShell</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClassroomGuard.Core\ClassroomGuard.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Resource: TrayIcon loads pack://application:,,,/app.ico -->
    <Resource Include="app.ico" />
    <Resource Include="Assets\*.png" />
    <Content Include="TestAssets\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Learning\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
