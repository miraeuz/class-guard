<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" x:Class="ClassroomGuard.StudentShell.MainWindow" Title="ClassroomGuard" WindowState="Maximized" WindowStyle="None" Icon="app.ico" Background="{DynamicResource BgApp}" UseLayoutRounding="True" MinWidth="640" MinHeight="440" SizeChanged="OnLayoutSizeChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal">
                    <ContentControl Template="{StaticResource SchoolMarkTemplate}" Width="20" Height="20" Foreground="{DynamicResource HeaderText}" Tag="{DynamicResource TassleAccent}" Margin="0,0,10,0"/>
                    <TextBlock Text="{DynamicResource UI_0}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource HeaderText}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="MachineNameText" FontSize="13" Margin="14,0,0,0" Foreground="{DynamicResource HeaderTextMuted}" VerticalAlignment="Center"/>
                </StackPanel>

                <Border x:Name="ConnectionPill" Style="{StaticResource StatusPill}" HorizontalAlignment="Right" Background="#1E293B" Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ConnectionDot" Style="{StaticResource StatusDot}" Fill="{DynamicResource TextMuted}"/>
                        <TextBlock x:Name="ConnectionText" Style="{StaticResource StatusPillText}" Foreground="{DynamicResource HeaderTextMuted}" Text="{DynamicResource UI_1}"/>
                    </StackPanel>
                </Border>
            <Button x:Name="ThemeButton" Grid.Column="2" Content="☾" Click="OnToggleTheme" Style="{StaticResource BtnGhost}" Foreground="White" ToolTip="Kun / tun" Margin="8,0"/><Button x:Name="RaiseHandButton" Grid.Column="3" Content="✋" Click="OnRaiseHand" Style="{StaticResource BtnGhost}" Foreground="White" ToolTip="Yordam so‘rash"/><Button Grid.Column="4" Content="" FontFamily="Segoe MDL2 Assets" Foreground="White" Background="#493367" Style="{StaticResource BtnGhost}" Margin="12,0,0,0" Click="OnGoToPc" ToolTip="Kompyuterga o‘tish — cheklovlar saqlanadi" AutomationProperties.Name="Kompyuterga o‘tish"/></Grid>
        </Border>

        
        <Grid x:Name="PageHost" Grid.Row="1">
        
        <Grid x:Name="PageStarter" Visibility="Visible">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" MaxWidth="980" Margin="24">
                <Border Background="{DynamicResource HeroGradient}" CornerRadius="24" Padding="24" Margin="0,0,0,24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="MIRAE ACADEMY · CLASS GUARD" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Kelajak shu yerdan boshlanadi." TextWrapping="Wrap" FontSize="30" FontWeight="Bold" Margin="0,12,0,10"/><TextBlock Text="O‘rganing, mashq qiling va yangi loyihalar yarating." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/></StackPanel><Image Grid.Column="1" Source="Assets/launch.png" Height="160" Stretch="Uniform" Margin="16,0,0,0"/></Grid></Border><Border Style="{StaticResource IconBadge}" Width="56" Height="56" Background="{DynamicResource HeaderBg}" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <ContentControl Template="{StaticResource SchoolMarkTemplate}" Width="28" Height="28" Foreground="{DynamicResource HeaderText}" Tag="{DynamicResource TassleAccent}"/>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock Text="{DynamicResource UI_0}" FontSize="28" FontWeight="Bold"/>
                    <Border Style="{StaticResource HelpIcon}" Margin="10,0,0,0" ToolTip="{DynamicResource UI_2}">
                        <TextBlock Style="{StaticResource HelpIconText}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{DynamicResource UI_3}" Foreground="{DynamicResource TextMuted}" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,32"/>

                <UniformGrid Columns="2" x:Name="RoleCards">
                    <Border Background="{DynamicResource StudentTint}" CornerRadius="16" Padding="28" Margin="0,0,12,0" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <StackPanel>
                            <Border Style="{StaticResource IconBadge}" Background="{DynamicResource BgInput}" HorizontalAlignment="Left" Margin="0,0,0,14">
                                <TextBlock Text="" Style="{StaticResource IconBadgeText}" FontFamily="Segoe MDL2 Assets"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource UI_4}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}"/>
                                <Border Style="{StaticResource HelpIcon}" ToolTip="{DynamicResource UI_5}">
                                    <TextBlock Style="{StaticResource HelpIconText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource UI_6}" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="{DynamicResource UI_7}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="13.5" LineHeight="21"/>
                            <Button Content="{DynamicResource UI_8}" Style="{StaticResource BtnPrimary}" Margin="0,22,0,0" HorizontalAlignment="Left" Click="OnContinue"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource TeacherTint}" CornerRadius="16" Padding="28" Margin="12,0,0,0" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <StackPanel>
                            <Border Style="{StaticResource IconBadge}" Background="{DynamicResource BgInput}" HorizontalAlignment="Left" Margin="0,0,0,14">
                                <TextBlock Text="" Style="{StaticResource IconBadgeText}" FontFamily="Segoe MDL2 Assets"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource UI_9}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                <Border Style="{StaticResource HelpIcon}" ToolTip="{DynamicResource UI_10}">
                                    <TextBlock Style="{StaticResource HelpIconText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource UI_11}" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="{DynamicResource UI_12}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="13.5" LineHeight="21"/>
                            <Button Content="{DynamicResource UI_11}" Style="{StaticResource BtnPrimary}" Margin="0,22,0,0" HorizontalAlignment="Left" Click="OnTeacherLoginClick"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Button Content="To‘garak · offline o‘rganish" Style="{StaticResource BtnGhost}" Margin="0,18,0,0" Click="OnOpenLearning"/>
                <Button Content="Favqulodda olib tashlash" Style="{StaticResource BtnGhost}" Click="OnEmergencyUninstall"/>
                <TextBlock x:Name="StarterStatus" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,28,0,0" FontSize="13"/>

                <Button Content="{DynamicResource UI_13}" Style="{StaticResource BtnGhost}" HorizontalAlignment="Center" Margin="0,6,0,0" Click="OnShowInstallCode"/>
            </StackPanel>
        </ScrollViewer></Grid>

        
        <Grid x:Name="PageStudent" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" x:Name="SidebarColumn"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            
            <Border Grid.Column="0" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><DockPanel LastChildFill="True">
                    
                    <Button DockPanel.Dock="Top" x:Name="StudentSidebarToggle" Content="" FontFamily="Segoe MDL2 Assets" Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Margin="14,12,0,0" ToolTip="Menyuni yig‘ish / yoyish" AutomationProperties.Name="Menyuni yig‘ish yoki yoyish" Click="OnToggleSidebar"/><Button DockPanel.Dock="Bottom" x:Name="CompactPcButton" Content="" FontFamily="Segoe MDL2 Assets" Style="{StaticResource BtnGhost}" Visibility="Collapsed" Margin="12" ToolTip="Kompyuterga o‘tish" AutomationProperties.Name="Kompyuterga o‘tish" Click="OnGoToPc"/><StackPanel DockPanel.Dock="Top" Margin="20,24,20,16" x:Name="StudentSidebarBrand">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Template="{StaticResource SchoolMarkTemplate}" Width="28" Height="28" Foreground="{DynamicResource Accent}" Tag="{DynamicResource TassleAccent}"/>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource UI_0}" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="{DynamicResource UI_14}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    
                    <StackPanel DockPanel.Dock="Top" Margin="12,8,12,0">
                        <Button x:Name="NavHome" Style="{StaticResource NavBtn}" Tag="Home" Click="OnNavClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets"/>
                                <TextBlock Text="{DynamicResource UI_15}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavLibrary" Style="{StaticResource NavBtn}" Tag="Library" Click="OnNavClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets"/>
                                <TextBlock Text="{DynamicResource UI_16}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavSites" Style="{StaticResource NavBtn}" Tag="Sites" Click="OnNavClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets"/>
                                <TextBlock Text="{DynamicResource UI_17}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavApps" Style="{StaticResource NavBtn}" Tag="Apps" Click="OnNavClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets"/>
                                <TextBlock Text="{DynamicResource UI_18}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavTests" Style="{StaticResource NavBtn}" Tag="Tests" Click="OnNavClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets"/>
                                <TextBlock Text="{DynamicResource UI_19}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavTogarak" Style="{StaticResource NavBtn}" Tag="Togarak" Click="OnNavClick"><StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/><TextBlock Text="To‘garak"/></StackPanel></Button>
                        <Button x:Name="NavSettings" Style="{StaticResource NavBtn}" Tag="Settings" Click="OnNavClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets"/>
                                <TextBlock Text="{DynamicResource UI_20}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    
                    <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,20" x:Name="StudentSidebarFooter">
                        <Button Content="Kompyuterga o‘tish ↗" Style="{StaticResource BtnPrimary}" Click="OnGoToPc" Margin="0,0,0,10" ToolTip="Dashboard kichrayadi. Strict rejim va cheklovlar Agent xizmatida davom etadi."/><Border Background="{DynamicResource DangerSoft}" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource UI_21}" FontWeight="SemiBold" Foreground="{DynamicResource Danger}" FontSize="12"/>
                                <TextBlock x:Name="StudentStatus" Text="{DynamicResource UI_22}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button Content="{DynamicResource UI_11}" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Stretch" Click="OnShowTeacherLogin"/>
                    </StackPanel>
                </DockPanel>
            </ScrollViewer></Border>

            
            <Grid Grid.Column="1" Background="{DynamicResource BgApp}">
                
                <TextBlock x:Name="PcNumberWatermark" Text="{DynamicResource UI_23}" FontSize="180" FontWeight="Bold" Foreground="#0F172A" Opacity="0.04" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>

                
                <ScrollViewer x:Name="DashboardScroll" VerticalScrollBarVisibility="Auto" Padding="28,24">
                    <Grid>
                        
                        <StackPanel x:Name="ContentHome" Visibility="Visible">
                            
                            <Border Background="{DynamicResource HeroGradient}" CornerRadius="20" Padding="28" Margin="0,0,0,24" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.06" Color="#0F172A"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="GreetingText" Text="{DynamicResource UI_24}" FontSize="26" FontWeight="Bold"/>
                                        <TextBlock Text="{DynamicResource UI_25}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="14" Margin="0,8,0,0" MaxWidth="480"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                            <Border Style="{StaticResource StatusPill}" Background="{DynamicResource DangerSoft}" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Style="{StaticResource StatusDot}" Fill="{DynamicResource Danger}"/>
                                                    <TextBlock Text="{DynamicResource UI_26}" Style="{StaticResource StatusPillText}" Foreground="{DynamicResource Danger}" x:Name="ModeText"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource StatusPill}" Background="{DynamicResource AccentSoft}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Style="{StaticResource StatusDot}" Fill="{DynamicResource Accent}"/>
                                                    <TextBlock x:Name="PcNumberPill" Text="{DynamicResource UI_23}" Style="{StaticResource StatusPillText}" Foreground="{DynamicResource AccentText}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <Image x:Name="HomeArtwork" Grid.Column="1" Source="Assets/launch.png" Width="170" Height="150" Stretch="Uniform" Margin="16,0,0,0"/></Grid>
                            </Border>

                            
                            <TextBlock Text="{DynamicResource UI_27}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>
                            <UniformGrid Margin="0,0,0,24" Columns="4" x:Name="QuickCards">
                                <Button Style="{StaticResource CardButton}" Margin="0,0,12,12" Click="OnQuickLibrary" HorizontalContentAlignment="Stretch">
                                    <StackPanel>
                                        <TextBlock Text="" FontSize="28" Margin="0,0,0,8" FontFamily="Segoe MDL2 Assets"/>
                                        <TextBlock Text="{DynamicResource UI_16}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource UI_28}" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource CardButton}" Margin="0,0,12,12" Click="OnQuickSites" HorizontalContentAlignment="Stretch">
                                    <StackPanel>
                                        <TextBlock Text="" FontSize="28" Margin="0,0,0,8" FontFamily="Segoe MDL2 Assets"/>
                                        <TextBlock Text="{DynamicResource UI_29}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource UI_17}" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource CardButton}" Margin="0,0,12,12" Click="OnQuickApps" HorizontalContentAlignment="Stretch">
                                    <StackPanel>
                                        <TextBlock Text="" FontSize="28" Margin="0,0,0,8" FontFamily="Segoe MDL2 Assets"/>
                                        <TextBlock Text="{DynamicResource UI_18}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource UI_30}" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource CardButton}" Margin="0,0,12,12" Click="OnQuickTests" HorizontalContentAlignment="Stretch">
                                    <StackPanel>
                                        <TextBlock Text="" FontSize="28" Margin="0,0,0,8" FontFamily="Segoe MDL2 Assets"/>
                                        <TextBlock Text="{DynamicResource UI_19}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource UI_31}" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>

                            
                            <Border Background="{DynamicResource AccentSoft}" CornerRadius="14" Padding="18">
                                <TextBlock TextWrapping="Wrap" FontSize="13.5" LineHeight="20" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource UI_32}"/>
                            </Border>
                        </StackPanel>

                        
                        <StackPanel x:Name="ContentLibrary" Visibility="Collapsed">
                            <DockPanel Margin="0,0,0,16">
                                <TextBlock Text="{DynamicResource UI_16}" FontSize="24" FontWeight="Bold" DockPanel.Dock="Left"/>
                                <Button Content="{DynamicResource UI_33}" Style="{StaticResource BtnGhost}" HorizontalAlignment="Right" Click="OnRefreshLibrary"/>
                            </DockPanel>
                            <TextBlock Text="{DynamicResource UI_34}" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,16"/>

                            <TextBlock Text="{DynamicResource UI_35}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="LibraryOfflineList" Margin="0,0,0,20">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource CardButton}" Margin="0,0,0,10" Cursor="Hand" Click="OnOpenLibraryItem" HorizontalContentAlignment="Stretch">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="{Binding Category}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding PathOrUrl}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="LibraryOfflineEmpty" Text="{DynamicResource UI_36}" Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,0,0,20"/>

                            <TextBlock Text="{DynamicResource UI_37}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="LibraryOnlineList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource CardButton}" Margin="0,0,0,10" Cursor="Hand" Click="OnOpenLibraryItem" HorizontalContentAlignment="Stretch">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="{Binding Category}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding PathOrUrl}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="LibraryOnlineEmpty" Text="{DynamicResource UI_38}" Foreground="{DynamicResource TextMuted}" FontSize="13"/>
                        </StackPanel>

                        
                        <StackPanel x:Name="ContentSites" Visibility="Collapsed">
                            <DockPanel Margin="0,0,0,16">
                                <TextBlock Text="{DynamicResource UI_39}" FontSize="24" FontWeight="Bold" DockPanel.Dock="Left"/>
                                <Button Content="{DynamicResource UI_33}" Style="{StaticResource BtnGhost}" HorizontalAlignment="Right" Click="OnRefreshSites"/>
                            </DockPanel>
                            <TextBlock x:Name="SitesModeText" Text="{DynamicResource UI_40}" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,12"/>
                            <Border Style="{StaticResource ContentCard}" Margin="0,0,0,12">
                                <ListBox x:Name="SitesListBox" BorderThickness="0" Background="Transparent" MaxHeight="320"/>
                            </Border>
                            <TextBlock x:Name="SitesEmptyHint" Text="{DynamicResource UI_41}" Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>

                        
                        <StackPanel x:Name="ContentApps" Visibility="Collapsed">
                            <DockPanel Margin="0,0,0,16">
                                <TextBlock Text="{DynamicResource UI_42}" FontSize="24" FontWeight="Bold" DockPanel.Dock="Left"/>
                                <Button Content="{DynamicResource UI_33}" Style="{StaticResource BtnGhost}" HorizontalAlignment="Right" Click="OnRefreshApps"/>
                            </DockPanel>
                            <TextBlock x:Name="AppsListStatus" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,12" Text="{DynamicResource UI_43}"/>
                            <Border Style="{StaticResource ContentCard}" Margin="0,0,0,12">
                                <ListBox x:Name="AppsListBox" BorderThickness="0" Background="Transparent" MaxHeight="320"/>
                            </Border>
                            <Border Background="{DynamicResource AccentSoft}" CornerRadius="12" Padding="14">
                                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="19" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource UI_44}"/>
                            </Border>
                        </StackPanel>

                        
                        <StackPanel x:Name="ContentTests" Visibility="Collapsed">
                            
                            <StackPanel x:Name="TestPickerPanel">
                                <DockPanel Margin="0,0,0,16">
                                    <TextBlock Text="{DynamicResource UI_19}" FontSize="24" FontWeight="Bold" DockPanel.Dock="Left"/>
                                    <Button Content="{DynamicResource UI_33}" Style="{StaticResource BtnGhost}" HorizontalAlignment="Right" Click="OnRefreshTests"/>
                                </DockPanel>
                                <TextBlock Text="{DynamicResource UI_45}" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,16"/>
                                <Border Style="{StaticResource ContentCard}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource UI_46}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="TestClassBox" Margin="0,0,0,14" Padding="10,8" SelectionChanged="OnTestFilterChanged"/>
                                        <TextBlock Text="{DynamicResource UI_47}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="TestSubjectBox" Margin="0,0,0,14" Padding="10,8" SelectionChanged="OnTestFilterChanged"/>
                                        <TextBlock Text="{DynamicResource UI_48}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                        <ListBox x:Name="TestListBox" BorderThickness="1" BorderBrush="{DynamicResource Border}" MinHeight="180"/>
                                        <Button Content="{DynamicResource UI_49}" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="OnStartTest"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="TestsEmptyHint" Text="{DynamicResource UI_50}" Foreground="{DynamicResource TextMuted}" FontSize="13"/>
                            </StackPanel>

                            
                            <StackPanel x:Name="TestTakingPanel" Visibility="Collapsed">
                                <TextBlock x:Name="TestTakingTitle" FontSize="20" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TestTakingMeta" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,16"/>
                                <Border Background="{DynamicResource AccentSoft}" CornerRadius="14" Padding="16" Margin="0,0,0,16"><StackPanel><TextBlock Text="SAVOLLAR XARITASI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentText}"/><TextBlock Text="Raqamni bosib savolga o‘ting · rangli: javob berilgan · ★: qaytish belgisi" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,12"/><WrapPanel x:Name="TestPalette"/><ProgressBar x:Name="TestCompletion" Height="5" Margin="0,12,0,0" Foreground="{DynamicResource Accent}"/></StackPanel></Border><TextBlock x:Name="TestTimerText" FontWeight="Bold" Margin="0,0,0,8"/><TextBlock x:Name="TestSaveStatus" TextWrapping="Wrap" Margin="0,0,0,12"/><Border Style="{StaticResource ContentCard}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock x:Name="TestQuestionText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                        <wv2:WebView2 x:Name="QuestionRichView" Height="200" Visibility="Collapsed" Margin="0,0,0,16"/><StackPanel x:Name="TestOptionsPanel"/>
                                        <WrapPanel Margin="0,18,0,0">
                                            <Button Content="{DynamicResource UI_51}" Style="{StaticResource BtnGhost}" Click="OnTestPrev" Margin="0,0,8,0" x:Name="TestPreviousButton"/>
                                            <Button Content="{DynamicResource UI_52}" Style="{StaticResource BtnGhost}" Click="OnTestNext" Margin="0,0,8,0" x:Name="TestNextButton"/>
                                            <Button Content="{DynamicResource UI_53}" Style="{StaticResource BtnPrimary}" Click="OnTestFinish" x:Name="TestFinishButton"/>
                                        <Button x:Name="TestFlagButton" Content="☆ Belgilash" Style="{StaticResource BtnGhost}" Click="OnFlagQuestion"/><Button Content="Javobni tozalash" Style="{StaticResource BtnGhost}" Click="OnClearAnswer" x:Name="TestClearButton"/></WrapPanel>
